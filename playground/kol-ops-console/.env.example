# Copy to .env and edit. Loaded automatically by start.sh.

# --- backend bind ---
KOC_HOST=0.0.0.0
KOC_PORT=8765

# --- auth ---
# Must be ≥16 chars. If unset, start.sh generates an ephemeral one per run.
KOC_JWT_SECRET=change-me-to-a-32-byte-random-string
# Optional: separate Fernet secret for Gmail OAuth tokens (recommended in prod).
# When unset, KOC_JWT_SECRET is used. Decrypt accepts both during rotation.
# KOC_GMAIL_TOKEN_SECRET=another-32-byte-random-string

# --- per-operator Gmail OAuth ---
# KOC_GOOGLE_CLIENT_SECRET_PATH=/path/to/client_secret.json
# KOC_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/auth/google/callback
# KOC_GMAIL_TOKENS_DIR=~/.hermes/kol-ops/gmail_tokens

# --- bridge (kol-ops-bridge plugin) ---
KOC_BRIDGE_BASE=http://127.0.0.1:8080/api/plugins/kol-ops-bridge
KOC_BRIDGE_KEY=replace-with-bridge-key
KOC_BRIDGE_TIMEOUT_SEC=60
# LLM style distill (propose-edit-policy / run-jobs); default 300
# KOC_BRIDGE_LEARNING_TIMEOUT_SEC=300
# Bridge/poller use this to reach Console internal APIs (defaults to http://127.0.0.1:8765):
# KOC_CONSOLE_BASE=http://127.0.0.1:8765
# KOC_INTERNAL_API_KEY=<same as KOC_BRIDGE_KEY>

# --- hermes gateway (for /campaigns/{id}/start) ---
KOC_GATEWAY_BASE=http://127.0.0.1:8642
KOC_GATEWAY_KEY=replace-with-gateway-key

# --- runtime env tag stored in CAL writes ---
KOC_ENV=LIVE

# --- local Chrome (Hermes gateway worker / discovery runs) ---
# Brief field browser_mode defaults to local-chrome via KOL_BROWSER_MODE.
# Per-task tab isolation for concurrent discovery runs (Hermes plugin
# local-chrome-tab-pool, bundled backend — auto-loads on gateway restart):
#   LOCAL_CHROME_TAB_POOL=1   # default; one shared profile, one tab per task_id
#   LOCAL_CHROME_TAB_POOL=0   # legacy: all tasks share one CDP connection
# KOL_BROWSER_MODE=local-chrome
# DEBUG_CHROME_PORT=9222
# DEBUG_CHROME_PROFILE_DIR=$HOME/.hermes/local-chrome-debug-profile

# --- NoxInfluencer (gateway runs for nox-diligence / nox-supplement) ---
# NOXINFLUENCER_API_KEY=your-nox-skills-api-key
# HMAC for nox_console_dispatch in materialized campaign config (P3).
# Defaults to KOC_BRIDGE_KEY / HERMES_KOL_OPS_BRIDGE_KEY when unset.
# NOX_CONSOLE_DISPATCH_SECRET=shared-with-kol-orchestrator-profile
