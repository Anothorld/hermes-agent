# SEO Studio — environment variables
# Copy to .env and fill in. Pattern matches povison-cs-console Feishu auth.

# ── OIDC (Feishu AnyCross, browser login) ──
SEO_STUDIO_OIDC_CLIENT_ID=
SEO_STUDIO_OIDC_CLIENT_SECRET=
SEO_STUDIO_OIDC_WELL_KNOWN=https://anycross.feishu.cn/oidc/tenant/<tenant>/.well-known/openid-configuration
SEO_STUDIO_OIDC_REDIRECT_URI=https://<your-host>/auth/feishu/callback
SEO_STUDIO_OIDC_SCOPE=openid profile email offline_access

# ── Feishu H5 免登 (飞书客户端内打开，path B) ──
# open.feishu.cn 自建应用 App ID / Secret（与 AnyCross SSO 应用不同）
SEO_STUDIO_FEISHU_APP_ID=
SEO_STUDIO_FEISHU_APP_SECRET=

# ── Session (signed cookie) ──
# Required when OIDC or H5 is configured.
SEO_STUDIO_SESSION_SECRET=
SEO_STUDIO_SESSION_TTL_SEC=28800

# auto (default) | 1 | 0
SEO_STUDIO_REQUIRE_LOGIN=auto

# Set 0 for internal HTTP (Secure cookies dropped over plain HTTP).
SEO_STUDIO_COOKIE_SECURE=1

# Operator sqlite (first-login auto-provision)
SEO_STUDIO_OPERATOR_DB=~/.hermes/seo-studio/operators.db

# ── Stock images (body lifestyle / interior photos) ──
# At least one key required for P1 image search. Free keys:
#   Unsplash: https://unsplash.com/oauth/applications
#   Pexels:   https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
