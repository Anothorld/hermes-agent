# kol-ops-bridge + kol_reply_dispatcher — per-operator Gmail
# Copy to .env and source before starting bridge / poller.

# --- bridge HTTP ---
HERMES_KOL_OPS_BRIDGE_BASE=http://127.0.0.1:8080/api/plugins/kol-ops-bridge
HERMES_KOL_OPS_BRIDGE_KEY=replace-with-bridge-key

# --- KOL Ops Console internal API (multi-mailbox) ---
KOC_CONSOLE_BASE=http://127.0.0.1:8765
# Same value as Console KOC_BRIDGE_KEY / bridge key above:
KOC_INTERNAL_API_KEY=replace-with-bridge-key

# --- operator Gmail token files (materialized by Console) ---
KOC_GMAIL_TOKENS_DIR=~/.hermes/kol-ops/gmail_tokens
# Optional: Fernet secret when tokens were encrypted with a non-JWT key
# KOC_GMAIL_TOKEN_SECRET=another-32-byte-random-string

# --- unattended CLI / gateway approve fallback (optional) ---
# Console users.id used when approve body omits operator_user_id
# KOC_DEFAULT_OPERATOR_USER_ID=1

# --- multi-operator detection cache (seconds, default 60) ---
# KOC_GMAIL_CONNECTION_CACHE_SEC=60

# --- legacy single-mailbox fallback (when no gmail_connections exist) ---
# GOOGLE_TOKEN_PATH=~/.hermes/google_token.json

# --- Learning distill (apply_edit_policy / nightly cron) ---
# Style proposals REQUIRE a successful LLM call (no rule fallback).
# Default: Hermes ~/.hermes config → HTTP chat/completions (serve.py loads .env on start).
# Install in bridge venv: pip install certifi  (macOS HTTPS); optional: openai (for call_llm).
# Override only when learning should use a different model/key:
# KOL_LEARNING_LLM_API_KEY=sk-...
# KOL_LEARNING_LLM_MODEL=gpt-4.1-mini
# KOL_LEARNING_LLM_API_URL=https://api.openai.com/v1
# KOL_LEARNING_LLM_DISABLE_HERMES=1
# Or shell out: KOL_LEARNING_LLM_CMD='your-script-that-reads-prompt-on-stdin'

# Style-learning batch sampling (Stage B):
# KOL_STYLE_LEARNING_BATCH_SIZE=5             # min edited events before a proposal (plan: 3–5)
# KOL_STYLE_LEARNING_BATCH_ORDER=newest       # newest|oldest — newest tracks latest habits
# KOL_STYLE_LEARNING_MIN_DISTINCT_IDENTITIES=0  # >1 enforces cross-KOL diversity in a batch
# KOL_LEARNING_WINDOW_DAYS=90                 # default 90; set 0 to disable sliding window for distill sampling
# KOL_LEARNING_USER_STYLE_OWNER_ID=            # fix a single user_style owner; unset = per-operator
# KOL_STYLE_LEARNING_MERGE_MODE=llm_compress # llm_compress=LLM merge (default)|replace_section|append

# Collaboration outcome learning (result-level retros → outcome_strategy):
# KOL_OUTCOME_LEARNING_BATCH_SIZE=5             # collabs before Tier2 synthesis
# KOL_OUTCOME_LEARNING_MIN_FAILURES=3           # failures trigger synthesis earlier (first to hit wins)

# --- NoxInfluencer (kol-nox-* skills / nox_kol_tool.py) ---
# NOXINFLUENCER_API_KEY=your-nox-skills-api-key
