#!/bin/bash
# Povison Quality Check Images CLI Wrapper
# Usage: ./qc-images <command> [options]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="$SCRIPT_DIR/quality_check_images.py"

# Check if Python script exists
if [[ ! -f "$PYTHON_SCRIPT" ]]; then
    echo "Error: quality_check_images.py not found at $PYTHON_SCRIPT"
    exit 1
fi

# Check if requests library is available
python3 -c "import requests" 2>/dev/null || {
    echo "Error: requests library not installed. Installing..."
    pip3 install requests
}

# Run the Python script
python3 "$PYTHON_SCRIPT" "$@"